<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <link rel="manifest" href="/manifest.webmanifest">
  <script>
    if ('serviceWorker' in navigator) navigator.serviceWorker.register('/service-worker.js').catch(()=>{});
  </script>
</head>
<body>
  <!-- index.html left mostly unchanged; ensure manifest & SW registered -->
</body>
</html>
